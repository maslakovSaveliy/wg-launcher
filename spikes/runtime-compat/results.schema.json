{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maslakovSaveliy/wg-launcher/spikes/runtime-compat/results.schema.json",
  "title": "runtime-compat spike results (THROWAWAY)",
  "description": "Probe payloads POSTed by probe/ (kind probe, frame-time, cold-start) and the aggregate written by run.mjs (kind run).",
  "type": "object",
  "required": ["schemaVersion", "kind", "createdAt", "runtime"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "enum": ["probe", "frame-time", "cold-start", "run"] },
    "createdAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "label": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "probe" } } },
      "then": {
        "required": ["page", "data"],
        "properties": {
          "page": { "$ref": "#/$defs/page" },
          "data": {
            "type": "object",
            "required": ["checks"],
            "properties": {
              "checks": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": { "enum": ["webgl2", "webgpu", "coi", "wasm", "storage", "opfs", "idb", "audio"] },
                "additionalProperties": { "type": "object" },
                "properties": {
                  "webgl2": {
                    "type": "object",
                    "anyOf": [
                      { "required": ["available"], "properties": { "available": { "type": "boolean" } } },
                      { "required": ["error"] }
                    ]
                  },
                  "coi": {
                    "type": "object",
                    "anyOf": [
                      {
                        "required": ["crossOriginIsolated", "sharedArrayBufferDefined", "roundTrip"],
                        "properties": {
                          "crossOriginIsolated": { "type": "boolean" },
                          "sharedArrayBufferDefined": { "type": "boolean" },
                          "roundTrip": { "type": "boolean" }
                        }
                      },
                      { "required": ["error"] }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "frame-time" } } },
      "then": {
        "required": ["page", "data"],
        "properties": {
          "page": { "$ref": "#/$defs/page" },
          "data": {
            "type": "object",
            "required": ["scene", "settings", "vsync", "viewport", "stats"],
            "properties": {
              "scene": { "$ref": "#/$defs/scene" },
              "settings": {
                "type": "object",
                "required": ["load", "durationMs", "warmupMs"],
                "properties": {
                  "load": { "type": "number" },
                  "durationMs": { "type": "number" },
                  "warmupMs": { "type": "number" }
                }
              },
              "vsync": {
                "type": "object",
                "required": ["hostReportedHz", "intervalMs"],
                "properties": {
                  "hostReportedHz": { "type": ["number", "null"] },
                  "intervalMs": { "type": ["number", "null"] }
                }
              },
              "viewport": {
                "type": "object",
                "required": ["innerWidth", "innerHeight"],
                "properties": { "innerWidth": { "type": "number" }, "innerHeight": { "type": "number" } }
              },
              "stats": {
                "type": "object",
                "required": ["count", "p50Ms", "p95Ms", "longFrames", "longFrameShare"],
                "properties": {
                  "count": { "type": "integer", "minimum": 0 },
                  "p50Ms": { "type": ["number", "null"] },
                  "p95Ms": { "type": ["number", "null"] },
                  "longFrames": { "type": ["integer", "null"] },
                  "longFrameShare": { "type": ["number", "null"] }
                }
              },
              "deltasMs": { "type": ["array", "null"], "items": { "type": "number" } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "cold-start" } } },
      "then": {
        "required": ["page", "data"],
        "properties": {
          "page": { "$ref": "#/$defs/page" },
          "data": {
            "type": "object",
            "required": ["scene", "firstFrameWallMs", "spawnWallMs", "spawnToFirstFrameMs"],
            "properties": {
              "scene": { "$ref": "#/$defs/scene" },
              "firstFrameWallMs": { "type": "number" },
              "spawnWallMs": { "type": ["number", "null"] },
              "spawnToFirstFrameMs": { "type": ["number", "null"] }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "run" } } },
      "then": {
        "required": ["machine", "startedAt", "finishedAt", "hypotheses", "checks", "probeFiles", "leftoverProcesses"],
        "properties": {
          "machine": {
            "type": "object",
            "required": ["osVersion", "arch", "cpu", "gpu", "displayRefreshHz", "power", "screenLockedAtStart"],
            "properties": {
              "osVersion": { "type": "string" },
              "arch": { "type": "string" },
              "cpu": { "type": "string" },
              "gpu": { "type": "string" },
              "displayRefreshHz": { "type": ["number", "null"] },
              "power": { "type": "string" },
              "screenLockedAtStart": { "type": ["boolean", "null"] }
            }
          },
          "startedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
          "finishedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
          "hypotheses": {
            "type": "object",
            "propertyNames": { "pattern": "^H([1-9]|1[0-9]|2[01])(b|-[1-9])?$" },
            "additionalProperties": {
              "type": "object",
              "required": ["status", "reason"],
              "properties": {
                "status": {
                  "enum": [
                    "PASS",
                    "FAIL",
                    "INVALID",
                    "INCONCLUSIVE",
                    "CONDITIONAL",
                    "N/A",
                    "FALLBACK",
                    "REPORTED",
                    "NOT_RUN"
                  ]
                },
                "reason": { "type": "string" },
                "metrics": {}
              }
            }
          },
          "checks": { "type": "object" },
          "probeFiles": { "type": "array", "items": { "type": "string" } },
          "leftoverProcesses": { "type": "object" }
        }
      }
    }
  ],
  "$defs": {
    "runtime": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "version": { "type": "string", "minLength": 1 },
        "chromium": { "type": ["string", "null"] },
        "node": { "type": ["string", "null"] },
        "userAgent": { "type": "string" }
      }
    },
    "page": {
      "type": "object",
      "required": ["url", "visibility"],
      "properties": {
        "url": { "type": "string" },
        "devicePixelRatio": { "type": "number" },
        "visibility": {
          "type": "object",
          "required": ["log", "everHidden", "everUnfocused"],
          "properties": {
            "log": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["t", "event", "visibilityState", "hasFocus"]
              }
            },
            "everHidden": { "type": "boolean" },
            "everUnfocused": { "type": "boolean" }
          }
        }
      }
    },
    "scene": {
      "type": "object",
      "required": ["renderer", "softwareRenderer", "load", "instances", "seed", "cssWidth", "cssHeight", "devicePixelRatio"],
      "properties": {
        "renderer": { "type": ["string", "null"] },
        "softwareRenderer": { "type": ["boolean", "null"] },
        "load": { "type": "number" },
        "instances": { "type": "integer" },
        "seed": { "type": "integer" },
        "cssWidth": { "type": "number" },
        "cssHeight": { "type": "number" },
        "devicePixelRatio": { "type": "number" }
      }
    }
  }
}
