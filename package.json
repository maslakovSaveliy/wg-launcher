{
  "name": "wg-launcher",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source desktop library and launcher for web games",
  "license": "AGPL-3.0-or-later",
  "author": "maslakovSaveliy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maslakovSaveliy/wg-launcher.git"
  },
  "bugs": "https://github.com/maslakovSaveliy/wg-launcher/issues",
  "homepage": "https://github.com/maslakovSaveliy/wg-launcher#readme",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "lefthook install",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -b . fixtures/test-games/progress-lab packages/shared packages/snapshot packages/exporters apps/desktop/tsconfig.node.json apps/desktop/tsconfig.preload.json apps/desktop/tsconfig.web.json apps/desktop/tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "pnpm run test:e2e:desktop && pnpm run test:e2e:exporters && pnpm run test:e2e:fixture",
    "test:e2e:desktop": "pnpm --filter @wg-launcher/desktop run test:e2e",
    "test:e2e:exporters": "pnpm --filter @wg-launcher/exporters run test:browser",
    "test:e2e:fixture": "pnpm --filter @wg-launcher/fixture-progress-lab run test:e2e",
    "licenses:check": "node scripts/check-licenses.mjs",
    "paths:check": "node scripts/check-machine-paths.mjs",
    "bundle:check": "pnpm --filter @wg-launcher/desktop run check:bundle",
    "docs:lint": "markdownlint-cli2 \"**/*.md\"",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm licenses:check && pnpm paths:check && pnpm bundle:check && pnpm docs:lint"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@types/node": "24.19.2",
    "lefthook": "2.2.2",
    "markdownlint-cli2": "0.24.0",
    "secretlint": "13.0.7",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
